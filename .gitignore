# because unpickling executes arbitrary code and the artefacts are locked to a
# specific scikit-learn / xgboost build.
# ---------------------------------------------------------------------------
*.pkl
*.joblib

# ---------------------------------------------------------------------------
# results/: regenerated by the scripts and excluded by default. The ranked
# Materials Project screening output of scripts/21 is shipped.
# ---------------------------------------------------------------------------
